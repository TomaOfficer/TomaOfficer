---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Footer from '../components/Footer.astro';
import '../styles/style.css';
interface Page { title: string; description: string; path: string; type?: string; image?: string; imageAlt?: string; card?: string; fonts?: string[]; jsonLd?: unknown; published?: string; modified?: string; noindex?: boolean; }
interface Props { page: Page; bodyClass?: string; }
const { page, bodyClass } = Astro.props;
const canonical = new URL(page.path, Astro.site).href;
let image = page.image || '/og/default.png';
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.png', { eager: true });
if (image.includes('/assets/work/')) {
  const source = images[`../assets/work/${image.split('/').pop()}`]?.default;
  if (source) image = (await getImage({ src: source, format: 'png' })).src;
}
image = new URL(image, Astro.site).href;
const originalImage = page.image;
const jsonLd = JSON.stringify(page.jsonLd || {}).replaceAll('<', '\\u003c');
const resolvedJsonLd = originalImage ? jsonLd.replaceAll(originalImage, image) : jsonLd;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="author" content="Thomas F. Officer" />
    <meta name="robots" content={page.noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={page.type || 'website'} />
    <meta property="og:site_name" content="Thomas F. Officer" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={page.imageAlt || 'Thomas Officer'} />
    <meta name="twitter:card" content={page.card || 'summary_large_image'} />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={image} />
    {page.published && <meta property="article:published_time" content={page.published} />}
    {page.modified && <meta property="article:modified_time" content={page.modified} />}
    {(page.fonts || []).map(font => <link rel="preload" href={`/${font}`} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/assets/tfo-favicon.ico" type="image/x-icon" />
    <link rel="alternate" type="application/rss+xml" title="Thomas Officer — Writing" href="/rss.xml" />
    <script type="application/ld+json" set:html={resolvedJsonLd} />
  </head>
  <body class={bodyClass}><slot /><Footer /></body>
</html>
