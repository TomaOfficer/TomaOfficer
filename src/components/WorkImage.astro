---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { name: string; alt: string; sizes: string; class?: string; loading?: 'lazy' | 'eager'; fetchpriority?: 'high' | 'low' | 'auto'; decoding?: 'async' | 'sync' | 'auto'; }
const { name, ...attrs } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.png', { eager: true });
const source = images[`../assets/work/${name}`]?.default;
if (!source) throw new Error(`Unknown case-study image: ${name}`);
const full = await getImage({ src: source, format: 'webp', width: source.width });
---
<Picture src={source} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 768, 960, 1600].filter(w => w <= source.width)} data-full-src={full.src} {...attrs} />
