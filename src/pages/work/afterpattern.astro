---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeLogo from '../../components/HomeLogo.astro';
import pages from '../../data/pages.json';
import WorkImage from '../../components/WorkImage.astro';
---
<BaseLayout page={pages["work/afterpattern"]}>

    <HomeLogo />

    <main id="content" class="case-study-page">
    <!-- Title Section -->
    <div class="title-section">
      <div class="title-section__wrapper">
        <h1>Afterpattern</h1>
        <p class="title-section__description">
          No-code app builder for lawyers
        </p>
      </div>
    </div>

    <!-- Case Study Hero -->
    <div class="case-study-hero">
      <div class="case-study-hero__wrapper">
        <div class="case-study-hero__colLeft">
          <h2>Role</h2>
          <p class="case-study-hero__meta">Cofounder, 2016-2021</p>

          <h2>Team</h2>
          <p class="case-study-hero__meta">3 cofounders + contractors</p>

          <h2>Platforms</h2>
          <p class="case-study-hero__meta">Web App</p>
        </div>
        <div class="case-study-hero__colRight">
          <h2>Overview</h2>
          <p>
            Afterpattern was a no-code platform that enabled lawyers to build
            software applications. We merged the deep expertise of law firms
            with the efficiency of tech companies like LegalZoom, allowing legal
            professionals to convert their expensive knowledge into affordable,
            accessible, and personalized software products.
          </p>
        </div>
      </div>
    </div>

    <!-- Highlight -->
    <div class="case-study-highlight">
      <div class="case-study-highlight__wrapper">
        <p>
          Acquired by NetDocuments in 2021 after helping 500,000+ people access
          legal services.
        </p>
      </div>
    </div>

    <!-- Hero Image -->
    <section class="case-study-section">
      <div class="aside-back"></div>
      <div class="content">
        <WorkImage name="ap-showcase-builder2021.png" alt="Afterpattern app builder 2021" class="portfolio-image" decoding="async" fetchpriority="high" sizes="(max-width: 1135px) calc(100vw - 40px), 696px" />
        <p class="portfolio-caption">app builder 2021</p>
      </div>
      <div class="aside"></div>
    </section>

    <!-- Goals -->
    <section class="case-study-section">
      <div class="aside-back"></div>
      <div class="content">
        <h2>Goals</h2>
        <div class="goals-list">
          <div class="goal-item">
            <div class="goal-item__number">1</div>
            <div class="goal-item__text">
              <strong>Bridge the justice gap.</strong>
              <span
                >Make legal services accessible to modest means Americans who
                can't afford traditional lawyers but don't qualify for legal
                aid.</span
              >
            </div>
          </div>
          <div class="goal-item">
            <div class="goal-item__number">2</div>
            <div class="goal-item__text">
              <strong>Empower lawyers to build software.</strong>
              <span
                >Give legal professionals the tools to transform their expertise
                into scalable applications without needing to code.</span
              >
            </div>
          </div>
          <div class="goal-item">
            <div class="goal-item__number">3</div>
            <div class="goal-item__text">
              <strong>Create a new category.</strong>
              <span
                >Introduce the concept of lawyer-built legal apps to an industry
                that had never considered it possible.</span
              >
            </div>
          </div>
        </div>
      </div>
      <div class="aside"></div>
    </section>

    <!-- Origin Story -->
    <section class="case-study-section">
      <div class="aside-back"></div>
      <div class="content">
        <h2>Origin</h2>
        <p>
          In 2017, as Fellows at the
          <a href="blueridgelabs.html">Blue Ridge Labs tech incubator</a>, two
          insights shaped our perspective. First, modest means New Yorkers
          universally agreed that "lawyers are for rich people." Second, web
          apps like TurboTax and LegalZoom were offering quasi legal services at
          scale at affordable prices.
        </p>
        <p>
          What if the deep expertise of law firms could be merged with the
          efficiency of tech companies? What if there was a no-code app builder
          designed specifically for legal professionals?
        </p>
        <div class="portfolio-grid">
          <div>
            <WorkImage name="ap-showcase-builder2018.png" alt="Afterpattern app builder 2018" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc((100vw - 40px - 3em) / 3), 216px" />
            <p class="portfolio-caption">app builder 2018</p>
          </div>
          <div>
            <WorkImage name="ap-showcase-builder2019.png" alt="Afterpattern app builder 2019" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc((100vw - 40px - 3em) / 3), 216px" />
            <p class="portfolio-caption">app builder 2019</p>
          </div>
          <div>
            <WorkImage name="ap-showcase-builder2020.png" alt="Afterpattern app builder 2020" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc((100vw - 40px - 3em) / 3), 216px" />
            <p class="portfolio-caption">app builder 2020</p>
          </div>
        </div>
      </div>
      <div class="aside"></div>
    </section>

    <!-- Product Suite -->
    <section class="case-study-section">
      <div class="aside-back"></div>
      <div class="content">
        <h2>Product Suite</h2>
        <p>
          We didn't start by building a no-code app builder. We started by
          observing tech-savvy, entrepreneurial lawyers using
          <a href="https://docassemble.org/" target="_blank" rel="noopener noreferrer">Docassemble</a>, an
          open-source expert system. In 2017, we launched The Docassemble
          Toolkit. By 2018, we had the confidence to launch our own no-code app
          builder.
        </p>
        <p>
          By 2021, Afterpattern offered a full suite including an Airtable-like
          database, a document template editor with precise customization rules,
          and the ability to create protected client portals.
        </p>
        <WorkImage name="ap-showcase-database.png" alt="Project database" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc(100vw - 40px), 696px" />
        <p class="portfolio-caption">project database</p>

        <div class="portfolio-grid">
          <div>
            <WorkImage name="ap-showcase-template.png" alt="Document template editor" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc((100vw - 40px - 3em) / 3), 216px" />
            <p class="portfolio-caption">document template editor</p>
          </div>
          <div>
            <WorkImage name="ap-showcase-app.png" alt="App made in Afterpattern" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc((100vw - 40px - 3em) / 3), 216px" />
            <p class="portfolio-caption">user-made app</p>
          </div>
          <div>
            <WorkImage name="ap-showcase-portal.png" alt="Client portal made in Afterpattern" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc((100vw - 40px - 3em) / 3), 216px" />
            <p class="portfolio-caption">user-made client portal</p>
          </div>
        </div>
      </div>
      <div class="aside"></div>
    </section>

    <!-- Marketing and Education -->
    <section class="case-study-section">
      <div class="aside-back"></div>
      <div class="content">
        <h2>Marketing &amp; Education</h2>
        <p>
          One of our biggest challenges was that Afterpattern was a new category
          of product. Our customers had never built legal apps before. Before we
          could train them how to do it, we had to convince them why they
          should.
        </p>
        <p>
          I dedicated an immeasurable amount of time to the conception and
          development of Afterpattern University. It became not only a platform
          to provide technical know-how, but also a stage to emphasize the
          potential benefits and capabilities of legal apps.
        </p>
        <WorkImage name="ap-showcase-marketing.png" alt="Marketing materials" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc(100vw - 40px), 696px" />
        <p class="portfolio-caption">marketing materials</p>

        <div class="portfolio-grid">
          <div>
            <WorkImage name="ap-showcase-lesson.png" alt="Afterpattern University lesson 2021" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc((100vw - 40px - 3em) / 3), 216px" />
            <p class="portfolio-caption">lesson</p>
          </div>
          <div>
            <WorkImage name="ap-showcase-tutorial.png" alt="Afterpattern University tutorial 2021" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc((100vw - 40px - 3em) / 3), 216px" />
            <p class="portfolio-caption">tutorial</p>
          </div>
          <div>
            <WorkImage name="ap-showcase-featured.png" alt="Community.lawyer app marketplace 2020" class="portfolio-image" decoding="async" loading="lazy" sizes="(max-width: 1135px) calc((100vw - 40px - 3em) / 3), 216px" />
            <p class="portfolio-caption">app marketplace</p>
          </div>
        </div>
      </div>
      <div class="aside"></div>
    </section>

    <!-- Impact -->
    <section class="case-study-section">
      <div class="aside-back"></div>
      <div class="content">
        <h2>Impact</h2>
        <p>
          Before it was
          <a
            href="https://www.netdocuments.com/press-releases/netdocuments-inspires-productivity-with-acquisition-of-afterpattern-document-automation"
            target="_blank"
            rel="noopener noreferrer"
            >acquired by NetDocuments</a
          >
          in November 2021, Afterpattern was the preferred app development tool
          for some of the most innovative legal professionals in the United
          States. These apps not only won national and regional awards, they
          helped more than 500,000 people access a wide range of traditionally
          expensive legal services—from keeping tenants in their homes during
          the COVID pandemic to helping immigrants navigate the Trump
          administration's "Muslim travel ban."
        </p>
        <p>
          Today, as part of NetDocuments, Afterpattern continues to
          revolutionize legal services, maintaining its commitment to making the
          law understandable, affordable, and within reach for all.
        </p>
      </div>
      <div class="aside"></div>
    </section>

    </main>

    

    <script>import "../../scripts/lightbox.js";</script>
  
</BaseLayout>
