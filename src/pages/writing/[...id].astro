---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeLogo from '../../components/HomeLogo.astro';
import { visiblePosts, dateLabel } from '../../lib/posts';
import '../../styles/writing.css';
export async function getStaticPaths() {
  return (await visiblePosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, ogImage, draft } = post.data;
const image = ogImage ? (await getImage({ src: ogImage, format: 'png' })).src : '/og/default.png';
const path = `/writing/${post.id}`;
const page = {
  title: `${title} | Thomas F. Officer`, description, path, type: 'article', image,
  card: 'summary_large_image', published: pubDate.toISOString(), modified: updatedDate?.toISOString(), noindex: draft,
  jsonLd: { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
    datePublished: pubDate.toISOString(), dateModified: (updatedDate || pubDate).toISOString(),
    author: { '@type': 'Person', '@id': 'https://www.thomasofficer.com/#person', name: 'Thomas F. Officer', url: Astro.site?.href },
    image: new URL(image, Astro.site).href, mainEntityOfPage: new URL(path, Astro.site).href },
};
---
<BaseLayout page={page}>
<HomeLogo />
<main id="content" class="writing-page">
  <a class="writing-back" href="/writing">← Writing</a>
  <article>
    <header>{draft && <p class="draft-label">Draft — local preview</p>}
      <h1>{title}</h1>
      <p class="writing-date"><time datetime={pubDate.toISOString()}>{dateLabel(pubDate)}</time>
      {updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{dateLabel(updatedDate)}</time></>}</p>
    </header>
    <div class="post-body"><Content /></div>
  </article>
</main>
</BaseLayout>
